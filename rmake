#!/usr/bin/env bash

red="$(printf '\033[1;31m')"
green="$(printf '\033[1;32m')"
yellow="$(printf '\033[1;33m')"
cyan="$(printf '\033[1;36m')"
reset="$(printf '\033[0m')"
rst="$(printf '\033[0m')"

VERSION="linux7.0"

msg() {
  echo -e "[rmake]$*"
}

usage() {
	cat <<EOF

${cyan}VoidBR ISO Builder${reset}

${yellow}Usage:${reset}
    $0 ${green}<flavor>${reset}

${yellow}Examples:${reset}
    $0 all
    $0 base
    $0 install
    $0 xfce
    $0 gnome
    $0 plasma
    $0 cinnamon
    $0 mate
    $0 sway
    $0 hyprland
    $0 fullx

${yellow}Available flavors:${reset}
    ${green}all${reset}        Build all images
    ${green}base${reset}       Build Base ISO
    ${green}cinnamon${reset}   Build Cinnamon ISO
    ${green}gnome${reset}      Build GNOME ISO
    ${green}install${reset}    Build Installer ISO
    ${green}mate${reset}       Build MATE ISO
    ${green}plasma${reset}     Build KDE Plasma ISO
    ${green}sway${reset}       Build SWAY ISO
    ${green}hyprland${reset}   Build HYPRLAND ISO
    ${green}xfce${reset}       Build XFCE ISO
    ${green}fullx${reset}      Build ALL ISo
EOF
	exit 1
}

# É obrigatório informar um parâmetro
[[ $# -eq 0 ]] && usage

FLAVOR="${1,,}"

case "$FLAVOR" in
all)
	FLAVORS=(
		base
		install
		xfce
		gnome
		plasma
		cinnamon
		mate
		sway
		hyprland
		fullx
	)
	;;
base | install | xfce | gnome | plasma | cinnamon | mate | sway | hyprland | fullx)
	FLAVORS=("$FLAVOR")
	;;
*)
	msg "${red}Error:${reset} Invalid flavor '${yellow}${FLAVOR}${reset}'."
	echo
	usage
	;;
esac

msg "${cyan}Kernel   :${rst} ${green}${VERSION}${rst}"
for flavor in "${FLAVORS[@]}"; do
	msg "${cyan}Building :${rst} ${green}${flavor}${rst}"
	msg "${cyan}Running  :${rst} ${green}sudo bash mkiso --automatic -v ${VERSION} ${flavor}${rst}"

	[ "${flavor}" == 'base' ] && flavor=
	if sudo bash mkiso --automatic -v "${VERSION}" "${flavor}"; then
    echo
		msg "${green}✓ ${flavor} completed.${reset}"
	else
  	echo
		msg "${red}✗ Failed to build ${flavor}.${reset}"
		exit 1
	fi
done
msg "${green}✓ All requested builds completed successfully.${reset}"
