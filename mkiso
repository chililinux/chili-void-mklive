enable_services() {
	local SERVICE_LIST="$*"
	local service link

	for service in $SERVICE_LIST; do
		link="$ROOTFS/etc/runit/runsvdir/default/$service"
		print_step "Ativando serviço: $service"

		#		if [[ -L "$link" ]] &&
		#			[[ "$(readlink "$link")" == "/etc/sv/$service" ]]; then
		#			info_msg "service $service já está habilitado"
		#			continue
		#		fi

		if [[ ! -d "$ROOTFS/etc/sv/$service" ]]; then
			info_msg "service $service not found in $ROOTFS/etc/sv"
			continue
		fi

		run_cmd_new ln -snf "/etc/sv/$service" "$link"
		if [[ ! -L "$link" && ! -e "$link" ]] &&
			[[ ! "$(readlink "$link")" == "/etc/sv/$service" ]]; then
			info_msg "failed to enable service $service (broken symlink)"
		fi
	done
}

sh_make_iso() {
	mount_pseudofs

	#dica: No Void, com dbus ativo, o elogind e o polkitd sobem automaticamente.
	#      Você não precisa ativar os serviços deles no runit.
	: ${DEFAULT_SERVICE_LIST:=agetty-tty1 agetty-tty2 agetty-tty3 agetty-tty4 agetty-tty5 agetty-tty6 dbus socklog-unix nanoklogd udevd sshd NetworkManager dhcpcd chronyd}
	if $MAKE_X; then
		if $MAKE_HYPRLAND || $MAKE_MANGO || $MAKE_SWAY || $MAKE_GNOME; then
			: ${ADDITIONAL_SERVICE_LIST:=sddm}
		else
			: ${ADDITIONAL_SERVICE_LIST:=lightdm}
		fi
	fi

	if $MAKE_ENLIGHTENMENT; then
		: ${EXTRA_SERVICE_LIST:=acpid connmand}
	fi

	replicate '-'
	enable_services ${DEFAULT_SERVICE_LIST} ${SERVICE_LIST} ${ADDITIONAL_SERVICE_LIST} ${EXTRA_SERVICE_LIST}
	replicate '-'

	if [ "${#INCLUDE_DIRS[@]}" -gt 0 ]; then
		print_step "Copying directory structures into the rootfs ..."
		copy_include_directories
	fi

	# Dispara o void-install sozinho, mas SOMENTE quando a entrada
	# "Instalar" do menu de boot foi escolhida (identificada pelo
	# parâmetro exclusivo voidbr.autoinstall no cmdline — não usar
	# live.autologin sozinho aqui, pois a entrada de acessibilidade
	# (linuxa11y) também usa live.autologin e NÃO deve abrir o instalador).
	# Qualquer outra entrada de boot (linux, linuxram, linuxa11y, sessão
	# gráfica normal) continua se comportando exatamente como antes.
	print_step "Configurando autoexec do void-install (tty1) : $ROOTFS/etc/skel/.bash_profile"
	mkdir -p "$ROOTFS/etc/skel"
	cat >"$ROOTFS/etc/skel/.bash_profile" <<-'EOF'
		    #
		    # ~/.bash_profile
		    #

		    [[ -f ~/.bashrc ]] && . ~/.bashrc

				# Instalado pelo mkiso — dispara o void-install SOMENTE quando o
				# boot veio da entrada "Instalar" do menu (isolinux/GRUB), marcada
				# pelo parâmetro voidbr.autoinstall no cmdline do kernel. Qualquer
				# outra entrada de boot cai num shell normal, como sempre foi.
				if [ "$(tty)" = "/dev/tty1" ] && grep -qw 'voidbr.autoinstall' /proc/cmdline; then
					sudo /usr/bin/void-install
					echo
					echo "Instalador encerrado. Você está num shell bash normal agora."
					echo "Para rodar o instalador de novo: sudo void-install"
				fi
	EOF
	chmod 644 "$ROOTFS/etc/skel/.bash_profile"

	for file in ./grub/grub_void.cfg.in ./isolinux/isolinux.cfg.in ./limine/limine.conf.in; do
		print_step "Ajustando CDLABEL=$VOL_ID : ${file}"
		sudo sed -i "s/CDLABEL=[^ ]*/CDLABEL=${VOL_ID}/g" "$file"
	done

	#	configure_plymouth
	#configure_service_boot_logger
	#configure_service_plymouth_log
	#configure_service_plymouth_stop
	configure_etc_runit_core_services_quit_plymouth
	generate_initramfs
	if [ "$BOOTLOADER" = "limine" ]; then
		generate_limine_boot
	else
		generate_isolinux_boot
		generate_grub_efi_boot
	fi
	cleanup_rootfs
	local conf="$ROOTFS/etc/xbps.d/00-repository-main.conf"
	sh_remove_etc_xbps_00_repository_main_conf "$conf"
	sh_activating_pipewire
	if $MAKE_X && ! $MAKE_GNOME && ! $MAKE_HYPRLAND && ! $MAKE_MANGO && ! $MAKE_SWAY; then
		sh_configure_lightdm_default_session
	fi

  sh_set_edition_os_release() {
    local name="$1"
    name="${name^}"
    sed -i "s/^EDITION=.*/EDITION=\"$name\"/" "$ROOTFS"/etc/os-release
  }
  sh_set_edition_os_release "$name"

	# generate_squashfs
	#	generate_iso_image
}

