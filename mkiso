generate_limine_boot() {
	print_step "Gerando suporte Limine para sistema : BIOS + UEFI"
	{
		run_cmd_new cp -f limine/limine.conf.in "$LIMINE_DIR"/limine.conf
		run_cmd_new sed -i -e "s|@@KERNVER@@|${KERNELVERSION}|" \
			-e "s|@@KEYMAP@@|${KEYMAP}|" \
			-e "s|@@ARCH@@|$BASE_ARCH|" \
			-e "s|@@BOOT_TITLE@@|${BOOT_TITLE}|" \
			-e "s|@@BOOT_CMDLINE@@|${BOOT_CMDLINE}|" \
			-e "s|@@LOCALE@@|${LOCALE}|" "$LIMINE_DIR"/limine.conf

		# Wallpaper do tema (referenciado no limine.conf via
		# "boot():/boot/limine/voidbr-tokyonight.png"). O pacote
		# voidbr-limine-config já instala esse arquivo no ROOTFS, em
		# /boot/efi/limine/ (pensado pro sistema instalado) -- aqui só
		# copiamos ele de lá pro lugar novo, dentro da própria ISO.
		if [ -f "$ROOTFS/boot/efi/limine/voidbr-tokyonight.png" ]; then
			run_cmd_new cp -f "$ROOTFS/boot/efi/limine/voidbr-tokyonight.png" "$LIMINE_DIR"/
		else
			info_msg "AVISO: $ROOTFS/boot/efi/limine/voidbr-tokyonight.png não encontrado (voidbr-limine-config instalado?) -- Limine vai usar fundo padrão."
		fi

		# Binários do bootloader em si (ambos os modos, BIOS e UEFI, num
		# único conjunto de arquivos -- Limine não separa isolinux/grub).
		run_cmd_new cp -f "$LIMINE_DATADIR"/limine-bios.sys "$LIMINE_DIR"
		run_cmd_new cp -f "$LIMINE_DATADIR"/limine-bios-cd.bin "$LIMINE_DIR"
		run_cmd_new cp -f "$LIMINE_DATADIR"/limine-uefi-cd.bin "$LIMINE_DIR"

		# EFI/BOOT/ pra permitir boot direto de pendrive/HD gravado cru
		# (fora do El Torito, útil se a mídia for regravada como disco raw).
		run_cmd_new mkdir -p "$IMAGEDIR"/EFI/BOOT
		run_cmd_new cp -f "$LIMINE_DATADIR"/BOOTX64.EFI "$IMAGEDIR"/EFI/BOOT/
		run_cmd_new cp -f "$LIMINE_DATADIR"/BOOTIA32.EFI "$IMAGEDIR"/EFI/BOOT/

		# include memtest86+ (multiboot1, referenciado no limine.conf)
		run_cmd_new cp -f "$HOSTDIR"/boot/memtest86+/memtest.bin "$BOOT_DIR"
	}
}

generate_grub_efi_boot() {
	print_step "Gerando suporte GRUB para sistema : EFI"
	{
		run_cmd_new cp -f grub/grub.cfg "$GRUB_DIR"
		run_cmd_new cp -f grub/grub_void.cfg.in "$GRUB_DIR"/grub_void.cfg
		run_cmd_new sed -i -e "s|@@SPLASHIMAGE@@|$(basename "${SPLASH_IMAGE}")|" \
			-e "s|@@KERNVER@@|${KERNELVERSION}|" \
			-e "s|@@KEYMAP@@|${KEYMAP}|" \
			-e "s|@@ARCH@@|$BASE_ARCH|" \
			-e "s|@@BOOT_TITLE@@|${BOOT_TITLE}|" \
			-e "s|@@BOOT_CMDLINE@@|${BOOT_CMDLINE}|" \
			-e "s|@@LOCALE@@|${LOCALE}|" "$GRUB_DIR"/grub_void.cfg
		run_cmd_new mkdir -p "$GRUB_DIR"/fonts
		run_cmd_new cp -f "$GRUB_DATADIR"/unicode.pf2 "$GRUB_DIR"/fonts

		run_cmd_new modprobe -q loop || :

		# Create EFI vfat image.
		run_cmd_new truncate -s 32M "$GRUB_DIR"/efiboot.img
		run_cmd_new mkfs.vfat -F12 -S 512 -n "GRUB_UEFI" "$GRUB_DIR/efiboot.img"

		GRUB_EFI_TMPDIR="$(mktemp --tmpdir="$HOME" -d)"
		LOOP_DEVICE="$(losetup --show --find "${GRUB_DIR}"/efiboot.img)"
		run_cmd_new mount -o rw,flush -t vfat "${LOOP_DEVICE}" "${GRUB_EFI_TMPDIR}"

		run_cmd_new cp -a "$IMAGEDIR"/boot "$HOSTDIR"

		# Os dois grub-mkstandalone abaixo (i386-efi e x86_64-efi) sao
		# independentes entre si (saidas e diretorios de origem diferentes),
		# entao rodam em paralelo para ganhar tempo, em vez de sequencialmente.
		msg "${cyan}[⚙  ]${rst} grub-mkstandalone i386-efi + x86_64-efi (em paralelo)"
		if $QUIET; then
			xbps-uchroot "$HOSTDIR" grub-mkstandalone -- \
				--directory="/usr/lib/grub/i386-efi" \
				--format="i386-efi" \
				--output="/tmp/bootia32.efi" \
				"boot/grub/grub.cfg" &>/dev/null &
		else
			xbps-uchroot "$HOSTDIR" grub-mkstandalone -- \
				--directory="/usr/lib/grub/i386-efi" \
				--format="i386-efi" \
				--output="/tmp/bootia32.efi" \
				"boot/grub/grub.cfg" &
		fi
		pid_i386=$!

		if $QUIET; then
			xbps-uchroot "$HOSTDIR" grub-mkstandalone -- \
				--directory="/usr/lib/grub/x86_64-efi" \
				--format="x86_64-efi" \
				--output="/tmp/bootx64.efi" \
				"boot/grub/grub.cfg" &>/dev/null &
		else
			xbps-uchroot "$HOSTDIR" grub-mkstandalone -- \
				--directory="/usr/lib/grub/x86_64-efi" \
				--format="x86_64-efi" \
				--output="/tmp/bootx64.efi" \
				"boot/grub/grub.cfg" &
		fi
		pid_x86_64=$!

		wait "$pid_i386"
		result_i386=$?
		wait "$pid_x86_64"
		result_x86_64=$?

		if [ "$result_i386" -ne 0 ] || [ "$result_x86_64" -ne 0 ]; then
			run_cmd_new umount "$GRUB_EFI_TMPDIR"
			run_cmd_new losetup --detach "${LOOP_DEVICE}"
			die "Failed to generate EFI loader"
		fi

		run_cmd_new mkdir -p "${GRUB_EFI_TMPDIR}"/EFI/BOOT
		run_cmd_new cp -f "$HOSTDIR"/tmp/bootia32.efi "${GRUB_EFI_TMPDIR}"/EFI/BOOT/BOOTIA32.EFI
		run_cmd_new cp -f "$HOSTDIR"/tmp/bootx64.efi "${GRUB_EFI_TMPDIR}"/EFI/BOOT/BOOTX64.EFI
		run_cmd_new umount "$GRUB_EFI_TMPDIR"
		run_cmd_new losetup --detach "${LOOP_DEVICE}"
		run_cmd_new rm -rf "$GRUB_EFI_TMPDIR"

		# include memtest86+
		run_cmd_new cp -f "$HOSTDIR"/boot/memtest86+/memtest.efi "$BOOT_DIR"
	}
	#	} 2>&1 | tee -i -a "$BOOTLOG" >$LOGGER
}

get_compression_options() {
	local param
	case $1 in
	gzip) param=" -noappend -comp gzip -Xcompression-level 1" ;;
	xz) param=" -noappend -b 1048576 -comp xz -Xdict-size 100%" ;;
	zstd) param=" -noappend -b 1M -comp zstd -Xcompression-level 3" ;;
	lzma) param=" -noappend -b 1M -comp lzma" ;;
	lz4) param=" -noappend -b 1M -comp lz4 -Xhc" ;;
	bzip2) param=" -noappend -b 1M -comp bzip2" ;;
	lzo) param=" -noappend -b 1M -comp lzo" ;;
	*) die "Tipo de compressão squashfs desconhecido: '$1' (use lz4|gzip|bzip2|xz|zstd|lzma|lzo)" ;;
	esac
	echo "$param"
}

generate_squashfs() {
	local options=$(get_compression_options "$SQUASHFS_COMPRESSION")

	umount_pseudofs
	print_step "Gerando image squashfs ($SQUASHFS_COMPRESSION) de rootfs: ${yellow}$IMAGEDIR/LiveOS/squashfs.img"
	{
		ROOTFS_SIZE=$(du --apparent-size -sm "$ROOTFS" | awk '{print $1}')
		run_cmd_new mkdir -p "$BUILDDIR/tmp/LiveOS"
		# Folga reduzida de 2x para ~1.15x + margem fixa de 256M (a imagem antiga
		# usava o dobro do tamanho do rootfs sem necessidade real).
		EXT3_IMG_SIZE=$(((ROOTFS_SIZE * 115 / 100) + 256))
		run_cmd_new truncate -s "${EXT3_IMG_SIZE}M" "$BUILDDIR"/tmp/LiveOS/rootfs.img
		# mke2fs -d popula o filesystem DIRETO a partir do ROOTFS, sem precisar
		# montar via loop + cp -a + umount (evita uma copia inteira do rootfs
		# passando por I/O de mount de loop device). Journal desabilitado
		# (^has_journal) porque essa imagem só existe para ser lida uma vez
		# pelo mksquashfs logo em seguida e depois é apagada -- journaling é
		# overhead puro aqui.
		run_cmd_new mkfs.ext3 -F -q -O ^has_journal -d "$ROOTFS" -m1 "$BUILDDIR/tmp/LiveOS/rootfs.img" 2>&1 | tee -i -a "$BOOTLOG" >$LOGGER
		run_cmd_new mkdir -p "$IMAGEDIR/LiveOS"

		run_cmd_new "$HOSTDIR"/usr/bin/mksquashfs "$BUILDDIR"/tmp "$IMAGEDIR"/LiveOS/squashfs.img -noappend -b 1M -comp zstd -Xcompression-level 1 -processors "$(nproc)" || die "Failed to generate squashfs image"

		run_cmd_new chmod 444 "$IMAGEDIR/LiveOS/squashfs.img"
		#[ -z "$KEEP_BUILDDIR" ] && rm -rf "$ROOTFS"
		run_cmd_new rm -rf "$BUILDDIR/tmp"
	}
	#	} 2>&1 | tee -i -a "$BOOTLOG" >$LOGGER
}

generate_iso_image() {
	print_step "Gerando imagem ISO : ${yellow}$OUTPUT_FILE"
	{
		if [ "$BOOTLOADER" = "limine" ]; then
			run_cmd_new "$HOSTDIR"/usr/bin/xorriso \
				-as mkisofs \
				-iso-level 3 \
				-rock \
				-joliet \
				-max-iso9660-filenames \
				-omit-period \
				-omit-version-number \
				-relaxed-filenames \
				-allow-lowercase \
				-volid "$VOL_ID" \
				-b boot/limine/limine-bios-cd.bin \
				-no-emul-boot -boot-load-size 4 -boot-info-table \
				--efi-boot boot/limine/limine-uefi-cd.bin \
				-efi-boot-part --efi-boot-image --protective-msdos-label \
				-output "$OUTPUT_FILE" "$IMAGEDIR" || die "Failed to generate ISO image"

			# Grava o stage BIOS/MBR direto no arquivo da ISO -- necessário
			# pro boot funcionar de verdade quando a ISO for regravada crua
			# num pendrive (dd/Rufus/etc), não só em CD/DVD virtual.
			run_cmd_new "$HOSTDIR"/usr/bin/limine bios-install "$OUTPUT_FILE" || die "Failed to install Limine BIOS stage"
		else
			run_cmd_new "$HOSTDIR"/usr/bin/xorriso \
				-as mkisofs \
				-iso-level 3 \
				-rock \
				-joliet \
				-max-iso9660-filenames \
				-omit-period \
				-omit-version-number \
				-relaxed-filenames \
				-allow-lowercase \
				-volid "$VOL_ID" \
				-eltorito-boot boot/isolinux/isolinux.bin \
				-eltorito-catalog boot/isolinux/boot.cat \
				-no-emul-boot \
				-boot-load-size 4 -boot-info-table \
				-eltorito-alt-boot -e boot/grub/efiboot.img \
				-isohybrid-gpt-basdat \
				-no-emul-boot \
				-isohybrid-mbr "$SYSLINUX_DATADIR"/isohdpfx.bin \
				-output "$OUTPUT_FILE" "$IMAGEDIR" || die "Failed to generate ISO image"
		fi
	}
	#	} 2>&1 | tee -i -a "$BOOTLOG" >$LOGGER
	hsize=$(du -sh "$OUTPUT_FILE" | awk '{print $1}')
	chili-make-md5-iso "$OUTPUT_FILE"
	rm kernel-${name}.txt
	info_msg "Iso file created: ${green}$(readlink -f "$OUTPUT_FILE") ($hsize) successfully.${reset}"
}

