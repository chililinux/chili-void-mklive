generate_initramfs() {
	local _args

	# Garantia de segurança: verifica se KERNELVERSION está definida e se o diretório de módulos existe no ROOTFS
	if [ -z "$KERNELVERSION" ] || [ ! -d "$ROOTFS/lib/modules/$KERNELVERSION" ]; then
		# Tenta autodetectar a versão real instalada no chroot para não quebrar o script
		local detected_kver=$(ls "$ROOTFS/lib/modules" | head -n1)
		if [ -n "$detected_kver" ]; then
			KERNELVERSION="$detected_kver"
		else
			die "Erro: Kernel não foi encontrado instalado em $ROOTFS/lib/modules!"
		fi
	fi

	print_step "Gerando imagem initramfs (${INITRAMFS_COMPRESSION}) : ${yellow}${BOOT_DIR}/initrd"

	copy_dracut_files "$ROOTFS"
	copy_autoinstaller_files "$ROOTFS"

	# NOTA: o comando abaixo mantém o log via tee, mas a checagem de $result e o
	# die ficam FORA do pipe -- um 'die' dentro de um bloco à esquerda de um
	# pipe roda em subshell e NÃO interrompe o script principal.
	chroot "$ROOTFS" env PYTHONWARNINGS="ignore::SyntaxWarning" \
		/usr/bin/dracut \
		-N \
		--"${INITRAMFS_COMPRESSION}" \
		--add-drivers "ahci" \
		--force-add "vmklive autoinstaller" \
		--omit systemd "/boot/initrd" \
		$KERNELVERSION 2>&1 | tee -i -a "$BOOTLOG" >$LOGGER

	result="${PIPESTATUS[0]}"
	[ $result -ne 0 ] && die "Failed to generate the initramfs"

	if [ ! -f "$ROOTFS/boot/initrd" ]; then
		die "Erro crítico: O arquivo $ROOTFS/boot/initrd não foi gerado pelo dracut!"
	fi

	mv "$ROOTFS"/boot/initrd "$BOOT_DIR"
	cp "$ROOTFS"/boot/vmlinuz-$KERNELVERSION "$BOOT_DIR"/vmlinuz
	cp -Rpva "$ROOTFS"/boot/grub/themes "$BOOT_DIR/grub/"
}

cleanup_rootfs() {
	print_step "Limpando rootfs : $ROOTFS"
	for f in ${INITRAMFS_PKGS}; do
		revdeps=$(xbps-query -r "$ROOTFS" -X $f)
