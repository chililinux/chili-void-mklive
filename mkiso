cmd_install() {
	local PKGS="$*"
	LC_ALL=C \
		XBPS_ARCH=$BASE_ARCH \
		$XBPS_INSTALL_CMD \
		--unpack-only \
		--rootdir "$ROOTFS" ${XBPS_REPOSITORY} \
		--cachedir "$XBPS_CACHEDIR" \
		--update \
		--force --force \
		--yes $PKGS
}

install_packages() {
	cmd_logger "Instalando xbps pkg" '
        cmd_install -yu xbps
    '
	cmd_logger "Running dry-run for packages list selected..." '
		LC_ALL=C XBPS_ARCH=$BASE_ARCH "${XBPS_INSTALL_CMD}" \
			--rootdir "$ROOTFS" ${XBPS_REPOSITORY} \
			--cachedir "$XBPS_CACHEDIR" \
			--unpack-only \
            --update \
			--yes \
			--dry-run $PACKAGE_LIST $INITRAMFS_PKGS
    '

	mount_pseudofs

	cmd_logger "Instalando void meta pkgs : $PACKAGE_LIST" '
        cmd_install $PACKAGE_LIST
    '

	cmd_logger "Instalando void meta pkgs : $INITRAMFS_PKGS" '
        cmd_install $INITRAMFS_PKGS
    '

	cmd_logger "Instalando void meta pkgs : ADDITIONAL" '
        cmd_install $ADDITIONAL_PKGS
	'

	if [[ -n $COMMON_PKGS ]]; then
		cmd_logger "Instalando void meta pkgs : COMMON" '
            cmd_install $COMMON_PKGS
		'
	fi

	if [[ -n $ADISTRO_PKGS ]]; then
		cmd_logger "Instalando void meta pkgs : ADISTRO" '
		    cmd_install $ADISTRO_PKGS
		'
