configure_service_plymouth_stop() {
	print_step "Configurando serviço plymouth-stop : $ROOTFS/etc/sv"
	mkdir -p "$ROOTFS/etc/sv/plymouth-stop"
  tee "$ROOTFS/etc/sv/plymouth-stop/run" >/dev/null <<'EOF'
#!/bin/sh
[ -r ./conf ] && . ./conf
/usr/bin/plymouth --quit
# "plymouth --quit" às vezes retorna antes do daemon (plymouthd) ter
# terminado de verdade -- e ao morrer, ele reseta a fonte/console,
# sobrescrevendo qualquer coisa que a gente aplique logo em seguida.
# Espera o processo sumir de fato antes de mexer na fonte.
for i in $(seq 1 20); do
    pgrep -x plymouthd >/dev/null 2>&1 || break
    sleep 0.1
done
# O plymouth, ao sair do modo gráfico, costuma resetar a fonte do
# console pro padrão embutido do kernel -- reaplica a fonte configurada
# no rc.conf (ex: terminus via vconsole.font=/locale.sh) depois dele.
. /etc/rc.conf 2>/dev/null
[ -n "$FONT" ] && setfont "$FONT" 2>/dev/null
exit 0
EOF
	chmod +x "$ROOTFS/etc/sv/plymouth-stop/run"
	ln -sf "/etc/sv/plymouth-stop" "$ROOTFS/etc/runit/runsvdir/default/"
}

