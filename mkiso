sh_configure_rootfs() {
	# Configure dracut to use overlayfs for the writable overlay.
	print_step "Configurando rootfs : $ROOTFS"
	BOOT_CMDLINE="$BOOT_CMDLINE rd.overlay=1 "
	ARCH=$(xbps-uhelper arch)

	# Set defaults
	: ${BASE_ARCH:=$(xbps-uhelper arch 2>/dev/null || uname -m)}
	: ${XBPS_CACHEDIR:="$(pwd -P)"/xbps-cachedir-${BASE_ARCH}}
	: ${XBPS_HOST_CACHEDIR:="$(pwd -P)"/xbps-cachedir-${ARCH}}
	: ${KEYMAP:=br-abnt2}
	: ${LOCALE:=pt_BR.UTF-8}
	: ${INITRAMFS_COMPRESSION:=xz}
	: ${SQUASHFS_COMPRESSION:=zstd}
	: ${BASE_SYSTEM_PKG:=base-container-full}
	# : ${BASE_SYSTEM_PKG:=base-system}
	: ${BOOT_TITLE:="$title"}

	# Required packages in the image for a working system.
	PACKAGE_LIST="$BASE_SYSTEM_PKG $PACKAGE_LIST"

	#mount -o remount,size=18G,mode=1777 tmpfs /tmp
	#ROOTDIR='/tmp'
	#mount -o remount,size=18G,mode=1777 tmpfs /dev/shm
	#ROOTDIR='/dev/shm'
	#mount /dev/nvme0n1p2 /mnt/voidlinux
	#ROOTDIR='/mnt/voidlinux/@/lixo'
	: "${ROOTDIR:=/lfs/voidbr}"

	if [ -n "$ROOTDIR" ]; then
		BUILDDIR="$ROOTDIR/$name"
		#		[ -d "$BUILDDIR" ] && [ -z "$KEEP_BUILDDIR" ] && rm -rf --one-file-system "$BUILDDIR"
		mkdir -p "$BUILDDIR"
	else
		BUILDDIR=$(mktemp --tmpdir="$(pwd -P)" -d)
	fi

	BUILDDIR=$(readlink -f "$BUILDDIR")
	IMAGEDIR="$BUILDDIR/image"
	ROOTFS="$BUILDDIR/rootfs"
	HOSTDIR="$ROOTDIR/hostdir"
	BOOT_DIR="$IMAGEDIR/boot"
	ISOLINUX_DIR="$BOOT_DIR/isolinux"
	GRUB_DIR="$BOOT_DIR/grub"
	LIMINE_DIR="$BOOT_DIR/limine"
	ISOLINUX_CFG="$ISOLINUX_DIR/isolinux.cfg"

	sh_create_etc_xbps_d_conf_00_repository_main_conf "$ROOTFS/etc/xbps.d/00-repository-main.conf"

	[ "${#INCLUDE_DIRS[@]}" -gt 0 ] && STEP_COUNT=$((STEP_COUNT + 1))
	[ -n "${IGNORE_PKGS}" ] && STEP_COUNT=$((STEP_COUNT + 1))

	: ${SYSLINUX_DATADIR:="$HOSTDIR"/usr/lib/syslinux}
	: ${GRUB_DATADIR:="$HOSTDIR"/usr/share/grub}
	: ${LIMINE_DATADIR:="$HOSTDIR"/usr/share/limine}
	: ${SPLASH_IMAGE:=data/splash.png}
	: ${XBPS_INSTALL_UNPACK_ONLY:=xbps-install --unpack-only --yes --ignore-file-conflicts}
	: ${XBPS_INSTALL_CMD:=xbps-install}
	: ${VINSTALL_CMD:=vinstall}
	: ${XBPS_REMOVE_CMD:=xbps-remove}
	: ${XBPS_QUERY_CMD:=xbps-query}
	: ${XBPS_RINDEX_CMD:=xbps-rindex}
	: ${XBPS_UHELPER_CMD:=xbps-uhelper}
	: ${XBPS_RECONFIGURE_CMD:=xbps-reconfigure}
	: ${OUTPUT_FILE="voidbr-live-$name-${BASE_ARCH}-$(uname -r)-$(sh_diahora).iso"}
	mkdir -p "$ROOTFS" "$HOSTDIR" "$ISOLINUX_DIR" "$GRUB_DIR" "$LIMINE_DIR"

	# Validação de espaço em disco inserida antes do resumo e do início das instalações
	verificar_espaco_livre

	sh_print_resume

}

sh_configure_linux() {
	#	print_step "Configurando kernel"
	# Get linux version for ISO - If linux version option specified use
	if [ -n "$LINUX_VERSION" ]; then
		if ! echo "$LINUX_VERSION" | grep "linux[0-9._]\+"; then
			die "-v option must be in format linux<version>"
		fi
		_linux_series="$LINUX_VERSION"
		PACKAGE_LIST="$PACKAGE_LIST $LINUX_VERSION"
	else # Otherwise find latest stable version from linux meta-package
		_linux_series=$(
			XBPS_ARCH=$BASE_ARCH $XBPS_QUERY_CMD \
				--rootdir "$ROOTFS" ${XBPS_REPOSITORY:=-R} \
				--deps linux |
				grep 'linux[0-9._]\+'
		)
	fi

	_kver=$(
		XBPS_ARCH=$BASE_ARCH $XBPS_QUERY_CMD \
			--rootdir "$ROOTFS" ${XBPS_REPOSITORY:=-R} \
			--property pkgver ${_linux_series}
	)
	KERNELVERSION=$(
		$XBPS_UHELPER_CMD getpkgversion ${_kver}
	)
	if [ "$?" -ne "0" ]; then
		die "Failed to find kernel package version"
	fi
	OUTPUT_FILE="voidbr-live-$name-${BASE_ARCH}-${KERNELVERSION}-$(sh_diahora).iso"
	{
		echo "KERNELVERSION=$KERNELVERSION"
		echo "OUTPUT_FILE=$OUTPUT_FILE"
	} >kernel-${name}.txt

	print_step "Kernel Version: $KERNELVERSION"

}

