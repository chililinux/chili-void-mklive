enable_services() {
	local SERVICE_LIST="$*"
	local service link

	for service in $SERVICE_LIST; do
		link="$ROOTFS/etc/runit/runsvdir/default/$service"
		print_step "Ativando serviço: $service"

#		if [[ -L "$link" ]] &&
#			[[ "$(readlink "$link")" == "/etc/sv/$service" ]]; then
#			info_msg "service $service já está habilitado"
#			continue
#		fi

		if [[ ! -d "$ROOTFS/etc/sv/$service" ]]; then
			info_msg "service $service not found in $ROOTFS/etc/sv"
			continue
		fi

    run_cmd_new ln -snf "/etc/sv/$service" "$link"
    if [[ ! -L "$link" && ! -e "$link" ]] &&
       [[! "$(readlink "$link")" == "/etc/sv/$service" ]]; then
      info_msg "failed to enable service $service (broken symlink)"
    fi
	done
}

