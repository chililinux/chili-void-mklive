	BOOT_CMDLINE="$BOOT_CMDLINE rd.live.overlay.overlayfs=1 "
	ARCH=$(xbps-uhelper arch)

	# Set defaults
	: ${BASE_ARCH:=$(xbps-uhelper arch 2>/dev/null || uname -m)}
	: ${XBPS_CACHEDIR:="$(pwd -P)"/xbps-cachedir-${BASE_ARCH}}
	: ${XBPS_HOST_CACHEDIR:="$(pwd -P)"/xbps-cachedir-${ARCH}}
	: ${KEYMAP:=br-abnt2}
	: ${LOCALE:=pt_BR.UTF-8}
	: ${INITRAMFS_COMPRESSION:=xz}
	: ${SQUASHFS_COMPRESSION:=zstd}
	: ${BASE_SYSTEM_PKG:=base-system}
	: ${BOOT_TITLE:="$title"}

	# Required packages in the image for a working system.
	PACKAGE_LIST="$BASE_SYSTEM_PKG $PACKAGE_LIST"

	#mount -o remount,size=18G,mode=1777 tmpfs /tmp
	#ROOTDIR='/tmp'
	#mount -o remount,size=18G,mode=1777 tmpfs /dev/shm
	#ROOTDIR='/dev/shm'
	#mount /dev/nvme0n1p2 /mnt/voidlinux
	#ROOTDIR='/mnt/voidlinux/@/lixo'
	ROOTDIR="/lfs/voidlinux"

	if [ -n "$ROOTDIR" ]; then
		BUILDDIR="$ROOTDIR/$name"
		#		[ -d "$BUILDDIR" ] && [ -z "$KEEP_BUILDDIR" ] && rm -rf --one-file-system "$BUILDDIR"
		mkdir -p "$BUILDDIR"
	else
		BUILDDIR=$(mktemp --tmpdir="$(pwd -P)" -d)
	fi

	BUILDDIR=$(readlink -f "$BUILDDIR")
	IMAGEDIR="$BUILDDIR/image"
	#	ROOTFS="$IMAGEDIR/rootfs"
	ROOTFS="$BUILDDIR/rootfs"
	#	VOIDHOSTDIR="$BUILDDIR/void-host"
	VOIDHOSTDIR="$ROOTDIR/void-host"
	BOOT_DIR="$IMAGEDIR/boot"
	ISOLINUX_DIR="$BOOT_DIR/isolinux"
	GRUB_DIR="$BOOT_DIR/grub"
	ISOLINUX_CFG="$ISOLINUX_DIR/isolinux.cfg"

	sh_create_etc_xbps_d_conf_00_repository_main_conf

	[ "${#INCLUDE_DIRS[@]}" -gt 0 ] && STEP_COUNT=$((STEP_COUNT + 1))
	[ -n "${IGNORE_PKGS}" ] && STEP_COUNT=$((STEP_COUNT + 1))

	: ${SYSLINUX_DATADIR:="$VOIDHOSTDIR"/usr/lib/syslinux}
	: ${GRUB_DATADIR:="$VOIDHOSTDIR"/usr/share/grub}
	: ${SPLASH_IMAGE:=data/splash.png}
	: ${XBPS_INSTALL_UNPACK_ONLY:=xbps-install --unpack-only --yes --ignore-file-conflicts}
	: ${XBPS_INSTALL_CMD:=xbps-install}
	: ${XBPS_REMOVE_CMD:=xbps-remove}
	: ${XBPS_QUERY_CMD:=xbps-query}
	: ${XBPS_RINDEX_CMD:=xbps-rindex}
	: ${XBPS_UHELPER_CMD:=xbps-uhelper}
	: ${XBPS_RECONFIGURE_CMD:=xbps-reconfigure}
	: ${OUTPUT_FILE="voidbr-live-$name-${BASE_ARCH}-$(uname -r)-$(sh_diahora).iso"}
	mkdir -p "$ROOTFS" "$VOIDHOSTDIR" "$ISOLINUX_DIR" "$GRUB_DIR"

  # Validação de espaço em disco inserida antes do resumo e do início das instalações
	verificar_espaco_livre

	sh_print_resume

}

sh_configure_linux() {
	print_step "Configurando kernel"
	# Get linux version for ISO - If linux version option specified use
	if [ -n "$LINUX_VERSION" ]; then
		if ! echo "$LINUX_VERSION" | grep "linux[0-9._]\+"; then
			die "-v option must be in format linux<version>"
		fi
		_linux_series="$LINUX_VERSION"
		PACKAGE_LIST="$PACKAGE_LIST $LINUX_VERSION"
	else # Otherwise find latest stable version from linux meta-package
		_linux_series=$(
			XBPS_ARCH=$BASE_ARCH $XBPS_QUERY_CMD \
				--rootdir "$ROOTFS" ${XBPS_REPOSITORY:=-R} \
				--deps linux |
				grep 'linux[0-9._]\+'
		)
	fi

	_kver=$(
		XBPS_ARCH=$BASE_ARCH $XBPS_QUERY_CMD \
			--rootdir "$ROOTFS" ${XBPS_REPOSITORY:=-R} \
			--property pkgver ${_linux_series}
	)
	KERNELVERSION=$(
		$XBPS_UHELPER_CMD getpkgversion ${_kver}
	)
	if [ "$?" -ne "0" ]; then
		die "Failed to find kernel package version"
	fi
	OUTPUT_FILE="voidbr-live-$name-${BASE_ARCH}-${KERNELVERSION}-$(sh_diahora).iso"
	{
		echo "KERNELVERSION=$KERNELVERSION"
		echo "OUTPUT_FILE=$OUTPUT_FILE"
	} >kernel-${name}.txt

	print_step "Kernel Version: $KERNELVERSION"

}

sh_install_rootfs() {
	replicate
	cmd_logger "Sincronizando dados do repositório XBPS..." "
		copy_void_keys "$ROOTFS"
		copy_void_keys "$VOIDHOSTDIR"
		LC_ALL=C XBPS_ARCH=$BASE_ARCH $XBPS_INSTALL_CMD -Sy -r "$ROOTFS" -R ${XBPS_REPOSITORY}
		LC_ALL=C XBPS_ARCH=$ARCH $XBPS_INSTALL_CMD -Sy -r "$VOIDHOSTDIR" -R ${XBPS_REPOSITORY}
    "
	sh_configure_linux

	#	: ${OUTPUT_FILE="voidbr-live-$name-${BASE_ARCH}-${KERNELVERSION}-$(sh_diahora).iso"}
	install_prereqs

	mkdir -p "$ROOTFS"/etc
	[ -s data/motd ] && cp data/motd "$ROOTFS"/etc
	[ -s data/issue ] && cp data/issue "$ROOTFS"/etc

	if [ -n "$IGNORE_PKGS" ]; then
		print_step "Ignoring packages in the rootfs: ${IGNORE_PKGS} ..."
		ignore_packages
	fi

	print_step "Instalando pacotes void em $ROOTFS..."
	install_packages
	install_skel_root
	sh_reconfigure_pass2
	finish_clean
}

enable_services() {
	SERVICE_LIST="$*"
	for service in $SERVICE_LIST; do
		print_step "Ativando serviço : $service"
		if ! [ -e $ROOTFS/etc/sv/$service ]; then
			info_msg "service $service not in $ROOTFS/etc/sv"
			continue
		fi
		ln -sf /etc/sv/$service $ROOTFS/etc/runit/runsvdir/default/
	done
}

sh_make_iso() {
	mount_pseudofs
	#dica: No Void, com dbus ativo, o elogind e o polkitd sobem automaticamente.
	#      Você não precisa ativar os serviços deles no runit.
	: ${DEFAULT_SERVICE_LIST:=agetty-tty1 agetty-tty2 agetty-tty3 agetty-tty4 agetty-tty5 agetty-tty6 dbus socklog-unix nanoklogd udevd sshd NetworkManager dhcpcd chronyd}
	if $MAKE_X; then
		if $MAKE_GNOME; then
			: ${ADDITIONAL_SERVICE_LIST:=gdm avahi-daemon}
		else
			: ${ADDITIONAL_SERVICE_LIST:=lightdm avahi-daemon}
		fi
	fi

	if $MAKE_ENLIGHTENMENT; then
		: ${EXTRA_SERVICE_LIST:=acpid connmand}
	fi

	enable_services ${DEFAULT_SERVICE_LIST} ${SERVICE_LIST} ${ADDITIONAL_SERVICE_LIST} ${EXTRA_SERVICE_LIST}

	if [ "${#INCLUDE_DIRS[@]}" -gt 0 ]; then
		print_step "Copying directory structures into the rootfs ..."
		copy_include_directories
	fi

	print_step "Substituir 'CDLABEL=VOID_LIVE' por 'CDLABEL=$VOL_ID' em ./grub/grub_void.cfg.in e ./isolinux/isolinux.cfg.in"
	for file in ./grub/grub_void.cfg.in ./isolinux/isolinux.cfg.in; do
		sudo sed -i "s/CDLABEL=[^ ]*/CDLABEL=${VOL_ID}/g" "$file"
	done

	configure_plymouth
	#configure_service_boot_logger
	#configure_service_plymouth_log
	#configure_service_plymouth_stop
	configure_etc_runit_core_services_quit_plymouth
	generate_initramfs
	generate_isolinux_boot
	generate_grub_efi_boot
	cleanup_rootfs
	local conf="$ROOTFS/etc/xbps.d/00-repository-main.conf"
	sh_remove_etc_xbps_00_repository_main_conf
	generate_squashfs
	#	generate_iso_image
}

sh_remove_etc_xbps_00_repository_main_conf() {
	local conf="$ROOTFS/etc/xbps.d/00-repository-main.conf"
	rm -f $conf
}

verificar_espaco_livre() {
	# Garante que há pelo menos 15GB livres no diretório de compilação
	local espaco_livre=$(df -m "$ROOTDIR" | awk 'NR==2 {print $4}')
	if [ "$espaco_livre" -lt 15360 ]; then
		die "Espaço insuficiente em $ROOTDIR. São necessários pelo menos 15GB livres."
	fi
}

automatic=false
new_args=()
for arg in "$@"; do
	if [[ "$arg" == "--automatic" ]]; then
		automatic=true
		continue
	fi
	new_args+=("$arg")
done

# substitui os argumentos atuais
set -- "${new_args[@]}"

for arg in "$@"; do
	case "$arg" in
	-h | --help)
		usage
		exit 0
		;;
	esac
done

# shellcheck source=./lib.sh
source ./lib.sh

# main()
#
sh_setVarColors
sh_setEnvironment
sh_setLanguage
sh_checkDependencies

while getopts "a:b:r:c:C:T:Kk:l:i:I:S:s:o:p:g:v:VhXxYyQqWwNnEeFfAGPmM" opt; do
	case $opt in
	a) BASE_ARCH="$OPTARG" ;;
	b) BASE_SYSTEM_PKG="$OPTARG" ;;
	r) XBPS_REPOSITORY="--repository=$OPTARG $XBPS_REPOSITORY" ;;
	c) XBPS_CACHEDIR="$OPTARG" ;;
	g) IGNORE_PKGS="$IGNORE_PKGS $OPTARG" ;;
	K) KEEP_BUILDDIR=1 ;;
	k) KEYMAP="$OPTARG" ;;
	l) LOCALE="$OPTARG" ;;
	I) INCLUDE_DIRS+=("$OPTARG") ;;
	i) INITRAMFS_COMPRESSION="$OPTARG" ;;
	s) SQUASHFS_COMPRESSION="$OPTARG" ;;
	S) SERVICE_LIST="$SERVICE_LIST $OPTARG" ;;
	o) OUTPUT_FILE="$OPTARG" ;;
	p) PACKAGE_LIST="$PACKAGE_LIST $OPTARG" ;;
	C) BOOT_CMDLINE="$OPTARG" ;;
	T) BOOT_TITLE="$OPTARG" ;;
	x | X)
		MAKE_X=true
		MAKE_XFCE_BASE=true
		;;
	y | Y)
		MAKE_X=true
		MAKE_XFCE=true
		;;
	n | N)
		MAKE_X=true
		MAKE_CINNAMON=true
		;;
	m | M)
		MAKE_X=true
		MAKE_MATE=true
		;;
	w | W)
		MAKE_X=true
		MAKE_AWESOME=true
		;;
	e | E)
		MAKE_X=true
		MAKE_ENLIGHTENMENT=true
		;;
	f | F)
		MAKE_X=true
		MAKE_FLUXBOX=true
		;;
	G)
		MAKE_X=true
		MAKE_GNOME=true
		;;
	P)
		MAKE_X=true
		MAKE_PLASMA=true
		;;
	A)
		MAKE_X=true
		MAKE_FULL_X=true
		;;
	q | Q) QUIET=true ;;
	v) LINUX_VERSION="$OPTARG" ;;
	V)
		version
		exit 0
		;;
	h)
		usage
		exit 0
		;;
	*)
		usage >&2
		exit 1
		;;
	esac
done
shift $((OPTIND - 1))

# Check for root permissions.
if [ "$(id -u)" -ne 0 ]; then
	die "Must be run as root, exiting..."
fi

sh_config_distroname
sh_configure_rootfs
umount_pseudofs
sh_configure_packages
sh_install_rootfs
sh_make_iso
generate_iso_image
