install_packages() {
	#	cmd_logger "Instalando pacote voidbr-xbps" '
	#    cmd_install -yu voidbr-xbps
	#  '

	mount_pseudofs

	# Todos os grupos "normais" (sem necessidade de --force) instalados em uma
	# UNICA transacao xbps-install, em vez de uma chamada separada por grupo.
	# Cada chamada de xbps-install reprocessa repodata e recalcula a arvore de
	# dependencias do zero -- unificar evita esse retrabalho repetido.
	local ALL_NORMAL_PKGS="$PACKAGE_LIST $INITRAMFS_PKGS $ADDITIONAL_PKGS $COMMON_PKGS $ADISTRO_PKGS $AEXTRA_COMMON_PKGS ${ACONFIG_PKGS[*]} $AEXTRA_PKGS"
	cmd_logger "Instalando pacotes (grupo unificado: PACKAGE_LIST+INITRAMFS_PKGS+ADDITIONAL_PKGS+COMMON_PKGS+ADISTRO_PKGS+AEXTRA_COMMON_PKGS+ACONFIG_PKGS+AEXTRA_PKGS) -> $ROOTFS" '
    cmd_install $ALL_NORMAL_PKGS
  '
	replicate '-'

	# ASKEL_PKGS continua em transacao SEPARADA de propósito: são pacotes de
	# config que precisam de --force --force (sobrescrevem arquivos que
	# conflitam com pacotes já instalados). Antes eram N chamadas (uma por
	# pacote); agora é 1 chamada só, com todos de uma vez.
	if [[ -n "${ASKEL_PKGS[*]}" ]]; then
		cmd_logger "Instalando pacotes ASKEL_PKGS (forçado, grupo unificado) -> $ROOTFS" '
      cmd_install_force "${ASKEL_PKGS[*]}"
    '
		replicate '-'
	fi
	#    sh_reconfigure_pass1

}

