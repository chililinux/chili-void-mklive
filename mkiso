sh_setEnvironment() {
	declare -g BOOTLOG="/tmp/void-mklive-$(sh_diahora).log"
	declare -g LOGGER='/dev/tty8'
	: "${COL_NC='\e[0m'}" # No Color
	: "${COL_LIGHT_GREEN='\e[1;32m'}"
	: "${COL_LIGHT_RED='\e[1;31m'}"
	: "${DONE="${COL_LIGHT_GREEN} done!${COL_NC}"}"
	: "${OVER="\\r\\033[K"}"
	: "${DOTPREFIX="  ${black}::${reset} "}"
	: "${clrkey=${light_white}}"
	: "${TICK="${clrkey}[${green}✓✓✓${clrkey}]${rst}"}"
	: "${CROSS="${clrkey}[${red}✗✗✗${clrkey}]${rst}"}"
	: "${MID="${clrkey}[${red}✗✗${green}✓${clrkey}]${rst}"}"
	: "${WARN="${clrkey}[${yellow}⚠  ${clrkey}]${yellow}"}"
	: "${INFO="${clrkey}[${yellow}➡  ${clrkey}]${rst}"}"

}

sh_setLanguage() {
	# Detecta o locale real do host (LC_ALL tem prioridade sobre LANG, como no
	# sistema de locale padrão) para decidir o idioma do prompt [S/n] vs [Y/n]
	# em readconf(). Não usamos $LANGUAGE aqui porque ela é forçada para
	# pt_BR logo no topo do script quando não definida, o que mascararia o
	# locale de verdade configurado no host.
	: "${LC_DEFAULT:=$([[ ${LC_ALL:-${LANG:-}} == pt_BR* ]] && echo 0 || echo 1)}"

	cmsg_ERRO=$(gettext "ERRO")
	cmsg_InstalacaoAbortada=$(gettext "Instalação abortada")
	cmsg_CommandNotFound=$(gettext "não encontrei o comando")
	cmsg_ImpossivelContinuar=$(gettext "IMPOSSÍVEL CONTINUAR")
	cmsg_ImpossivelContinuar1=$(gettext "Esse script precisa dos comandos listados acima")
	cmsg_ImpossivelContinuar2=$(gettext "Instale-os e/ou verifique se estão no seu")
	cmsg_InstCommand=$(gettext "Instalar o(s) comando(s)")
	cmsg_RunNew=$(gettext "INFO: Rode novamente o aplicativo")
	cmsg_RunNewErro=$(gettext "ERRO na instalação dos comandos. Tente manualmente")
}

sh_checkDependencies() {
	local d
	local errorFound=false
	declare -a missing

	for d in "${DEPENDENCIES[@]}"; do
		if [[ -z $(command -v "$d") ]]; then
			missing+=("$d")
			errorFound=true
			printf '%s\n' "${red}${cmsg_ERRO}${reset}: ${cmsg_CommandNotFound} ${cyan}'$d'${reset}"
		fi
	done
	if $errorFound; then
		echo "${yellow}--------------${cmsg_ImpossivelContinuar}-------------${reset}"
		echo "${cmsg_ImpossivelContinuar1}" >&2
		echo "${cmsg_ImpossivelContinuar2} \$PATH" >&2
		echo "${yellow}-----------------------------------------------${reset}"

		if [[ "$distro" = @(void|voidbr|void-live|voidlinux) ]]; then
			echo
			if readconf "${yellow}${cmsg_InstCommand} '${cyan}${missing[*]}${reset}' ?"; then
				if xbps-install -Sy "${missing[@]}" -R $XBPS_REPOSITORY; then
					errorFound=false
					sh_checkDependencies
				else
					die "${cmsg_RunNewErro}"
				fi
			fi
		else
			die "${cmsg_ERRO}: ${cmsg_InstalacaoAbortada}..."
		fi
	fi
}

