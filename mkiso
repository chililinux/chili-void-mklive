# Guarda os argumentos originais ANTES de qualquer filtragem, para que uma
# eventual re-execução via elevate_to_root() (sh_checkroot) preserve exatamente
# o que o usuário digitou, incluindo --automatic.
ORIGINAL_ARGS=("$@")

# Pre-parse de --automatic e --bootloader: precisa acontecer ANTES do
# source ./lib.sh, pois select_mirrors_dialog() (chamada automaticamente
# ao carregar lib.sh) usa a variável $automatic internamente, e getopts
# não lida com opções longas (por isso o filtro manual aqui).
automatic=false
declare -g BOOTLOADER="grub"
new_args=()
for arg in "$@"; do
	if [[ "$arg" == "--automatic" ]]; then
		automatic=true
		continue
	fi
	if [[ "$arg" == --bootloader=* ]]; then
		BOOTLOADER="${arg#--bootloader=}"
		continue
	fi
	new_args+=("$arg")
done
set -- "${new_args[@]}"

case "$BOOTLOADER" in
grub | limine) ;;
*)
	echo "ERRO: --bootloader inválido: '$BOOTLOADER' (use 'grub' ou 'limine')" >&2
	exit 1
	;;
esac

